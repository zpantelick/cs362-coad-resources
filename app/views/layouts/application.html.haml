!!!
%html
  %head
    %title= full_title(yield(:title))
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload'
    = javascript_include_tag 'application', 'data-turbo-track': 'reload'
  %body
    = render 'layouts/nav'
    .container
      = render 'layouts/flashes'
      = yield
      = render 'layouts/footer'
